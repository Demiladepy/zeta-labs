# The web build needs packages/sdk + packages/dashboard in full.
# Only exclude what is genuinely heavy and irrelevant to it.
#
# NOTE: use leading slashes for root-only directories. A bare `scripts`
# also matches packages/sdk/scripts, which holds clean-dist.mjs that the
# SDK build invokes.

.git
node_modules
**/node_modules
target
**/target
**/dist
.keys
*.so

# Rust workspace — not part of the web build
/crates
/programs
/Cargo.toml
/Cargo.lock

# Repo material the site does not serve
/brand-assets
/docs
/scripts
/packages/brand-video
