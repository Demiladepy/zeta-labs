# Copy to scripts/devnet.env (gitignored). Never commit real keys.
#
#   copy scripts\devnet.env.example scripts\devnet.env

# Solana devnet RPC (use a provider if public faucet is rate-limited)
RPC_URL=https://api.devnet.solana.com
NETWORK=devnet

# Absolute path to your agent/lender keypair JSON (Solana CLI format: [1,2,3,...])
# Example: use your existing key outside the repo
AGENT_KEYPAIR_PATH=C:\Projects\Wire\anchor-keypair.json

# Optional: operator key for settle_and_seal (generate with solana-keygen)
# OPERATOR_KEYPAIR_PATH=C:\Projects\zeta-labs\.keys\operator.json

# x402 endpoint — use LOCAL playground (surfnet.dev URL alone returns 404)
# Start playground first: cd pay-kit/playground && pnpm dev
# Metered upto (POST) or fixed fortune (GET)
X402_ENDPOINT=http://127.0.0.1:3000/api/v1/summarize
PLAYGROUND_FAUCET_URL=http://127.0.0.1:3000/api/v1/faucet/airdrop
