{
  "name": "@zeta/sdk",
  "version": "0.1.0",
  "description": "Zeta Labs agent credit SDK. Types mirror crates/zeta-interface.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./paykit": {
      "types": "./dist/paykit/index.d.ts",
      "import": "./dist/paykit/index.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "import": "./dist/dashboard.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test test/**/*.test.ts",
    "devnet:preflight": "tsx scripts/devnet-preflight.ts",
    "devnet:fund": "tsx scripts/fund-devnet.ts",
    "paykit:smoke": "tsx scripts/paykit-smoke.ts",
    "x402:smoke": "tsx scripts/x402-devnet-smoke.ts",
    "devnet:spend-plan": "tsx scripts/devnet-spend-plan.ts",
    "devnet:spend-submit": "tsx scripts/devnet-spend-submit.ts",
    "devnet:policy-demos": "tsx scripts/devnet-policy-demos.ts",
    "devnet:phase2-preflight": "tsx scripts/devnet-phase2-preflight.ts",
    "devnet:agent-spend": "tsx scripts/devnet-agent-spend.ts",
    "devnet:swig-setup": "tsx scripts/devnet-swig-setup.ts",
    "devnet:swig-line-open": "tsx scripts/devnet-swig-line-open.ts",
    "devnet:swig-spend": "tsx scripts/devnet-swig-spend.ts",
    "clawpump:smoke": "tsx scripts/clawpump-smoke.ts",
    "pyth:aapl-compare": "tsx scripts/pyth-aapl-compare.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@pythnetwork/hermes-client": "^3.1.0",
    "@solana/kit": "^6.10.0",
    "@solana/pay-kit": "^0.12.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@swig-wallet/classic": "^2.1.0",
    "@swig-wallet/lib": "^2.1.0"
  }
}
